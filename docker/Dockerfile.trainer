# syntax=docker/dockerfile:1.7
ARG CUDA_BASE=nvidia/cuda:13.0.3-cudnn-runtime-ubuntu24.04
FROM ${CUDA_BASE}

ARG TORCH_VERSION=2.13.0
ARG TORCHVISION_VERSION=0.28.0
ARG PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu130
ARG GIT_REVISION=unknown

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    PET_GIT_REVISION=${GIT_REVISION} \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH

RUN apt-get update \
    && apt-get install --yes --no-install-recommends python3 python3-venv ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv "$VIRTUAL_ENV" \
    && pip install --no-cache-dir --upgrade pip==26.0.1

WORKDIR /app
COPY docker/requirements.runtime.txt /tmp/requirements.runtime.txt
RUN pip install --no-cache-dir \
        "torch==${TORCH_VERSION}" "torchvision==${TORCHVISION_VERSION}" \
        --index-url "${PYTORCH_INDEX_URL}" -c /tmp/requirements.runtime.txt \
    && pip install --no-cache-dir -r /tmp/requirements.runtime.txt

COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir --no-deps .
COPY configs ./configs
COPY scripts/runpod_training.sh ./scripts/runpod_training.sh
RUN useradd --create-home --uid 10001 appuser \
    && chmod 0555 /app/scripts/runpod_training.sh \
    && chown -R appuser:appuser /app

USER appuser
CMD ["python", "-m", "pet.cli.container_smoke", "--device", "cuda"]
